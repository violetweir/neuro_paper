\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Specifically, WCANet maintains a consistent performance upper hand across the entire evaluation spectrum (from 80M to 1078M FLOPs). }}{2}{section*.16}%
\contentsline {replaced}{Replaced: \truncate {\Changestruncatewidth }{highly effective for}}{2}{section*.17}%
