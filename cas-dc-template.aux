\citation{graham2021levit,liu2023efficientvit}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Object detection and instance segmentation results on COCO.} AP$^{\rm  b}$ and AP$^{\rm  m}$ indicate bounding box AP and mask AP, respectively. \chadded {\color  {red}For a fair comparison, all baselines are evaluated according to the training protocols reported in their original publications.} }}{8}{table.caption.34}\protected@file@percent }
